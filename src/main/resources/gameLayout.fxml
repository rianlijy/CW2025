<?import com.comp2042.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<StackPane fx:controller="com.comp2042.GuiController"
           xmlns:fx="http://javafx.com/fxml"
           alignment="CENTER">
    <HBox alignment="CENTER"
          spacing="0"
          style="-fx-padding:0; -fx-spacing:0;">
        <VBox alignment="CENTER" spacing="5">
            <Label text="HOLD"
                   styleClass="nextBrickLabel"
                   alignment="CENTER" />
            <VBox fx:id="leftDummy"
                  alignment="CENTER"
                  spacing="5"
                  prefHeight="100"
                  minHeight="100"
                  maxHeight="100"
                  prefWidth="100"
                  minWidth="100"
                  maxWidth="100"
                  style="-fx-border-color: red; -fx-border-width: 2; -fx-padding: 0;">
            </VBox>
            <Region prefHeight="305"/>

            <Label text="SCORE"
                   styleClass="nextBrickLabel"
                   alignment="CENTER" />
            <Label fx:id="scoreLabel"
                   styleClass="scoreClass"
                   text="0"
                   alignment="CENTER"/>
            <Region prefHeight="30"/>
        </VBox>

        <BorderPane fx:id="gameBoard"
                    styleClass="gameBoard"
                    prefWidth="200" prefHeight="400"
                    maxWidth="200" maxHeight="400">
            <center>
                <GridPane fx:id="gamePanel"
                          hgap="1"
                          vgap="1"
                          alignment="CENTER" />
            </center>
        </BorderPane>
        <VBox alignment="CENTER" spacing="5">
            <Label text="NEXT"
                   styleClass="nextBrickLabel"
                   alignment="CENTER" />
            <VBox fx:id="previewBox"
                  alignment="CENTER"
                  spacing="5"
                  prefWidth="120"
                  minWidth="120"
                  maxWidth="120"
                  style="-fx-border-color:red; -fx-border-width:2; -fx-padding:0;">
            </VBox>
            <Region prefHeight="250"/>
        </VBox>
    </HBox>
    <Group fx:id="groupNotification"
           StackPane.alignment="CENTER">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
            <Label fx:id="pauseLabel"
                   text="PAUSED"
                   styleClass="gameOverStyle"
                   visible="false"
                   alignment="CENTER"/>
        </VBox>
    </Group>
    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>



