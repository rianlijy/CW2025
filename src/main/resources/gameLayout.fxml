<?import com.comp2042.ui.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<?import javafx.scene.control.Slider?>
<StackPane fx:controller="com.comp2042.controller.GuiController"
           xmlns:fx="http://javafx.com/fxml"
           alignment="CENTER">
    <HBox alignment="CENTER"
          spacing="0"
          style="-fx-padding:0; -fx-spacing:0;">
        <VBox alignment="CENTER">
            <Label text="HOLD"
                   styleClass="nextBrickLabel"
                   alignment="CENTER" />
            <VBox fx:id="leftDummy"
                  alignment="CENTER"
                  spacing="5"
                  prefHeight="100"
                  prefWidth="100"
                  styleClass="holdPanel">
            </VBox>
            <Region prefHeight="247"/>

            <Label text="SCORE"
                   styleClass="nextBrickLabel"
                   alignment="CENTER" />
            <Label fx:id="scoreLabel"
                   styleClass="scoreClass"
                   text="0"
                   alignment="CENTER"/>
            <Label text="LEVEL"
                   styleClass="nextBrickLabel"
                   alignment="CENTER"/>
            <Label fx:id="levelLabel"
                   styleClass="scoreClass"
                   text="1"
                   alignment="CENTER"/>
            <Region prefHeight="35"/>
        </VBox>

        <BorderPane fx:id="gameBoard"
                    styleClass="gameBoard"
                    prefWidth="200" prefHeight="400"
                    maxWidth="200" maxHeight="400">
            <center>
                <GridPane fx:id="gamePanel"
                          hgap="1"
                          vgap="1"
                          alignment="CENTER" />
            </center>
        </BorderPane>
        <VBox alignment="CENTER" spacing="5">
            <Label text="NEXT"
                   styleClass="nextBrickLabel"
                   alignment="CENTER" />
            <VBox fx:id="previewBox"
                  alignment="CENTER"
                  spacing="5"
                  prefWidth="120"
                  styleClass="previewPanel">
            </VBox>
            <Region prefHeight="123"/>
            <Label text="VOLUME"
                   styleClass="nextBrickLabel"
                   alignment="CENTER"/>
            <Slider fx:id="volumeSlider"
                    min="0"
                    max="1"
                    value="0.5"
                    prefWidth="110"
                    majorTickUnit="0.5"
                    minorTickCount="4"
                    blockIncrement="0.1" />
            <Region prefHeight="55"/>
        </VBox>
    </HBox>
    <Group fx:id="groupNotification"
           StackPane.alignment="CENTER"
           translateX="-9">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
            <Label fx:id="pauseLabel"
                   text="PAUSED"
                   styleClass="gameOverStyle"
                   visible="false"
                   alignment="CENTER"/>
        </VBox>
    </Group>
    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>